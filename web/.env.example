# Supabase project credentials — SvelteKit public env vars.
# Copy to web/.env and fill from Supabase Dashboard → Project Settings → API.
# The publishable (anon) key is safe to expose to the browser; Row Level
# Security enforces access control in Postgres.
# https://supabase.com/docs/guides/auth/server-side/sveltekit
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
