# Supabase browser configuration. Public keys rely on RLS, not secrecy.
# Local development: run `bunx supabase start` from the repository root,
# then `bunx supabase status` for the local URL and publishable key.
# Keep local/staging identities separate from the hosted production project.
# Supply the same project URL/key to the engine's SUPABASE_* settings.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Engine origin. Required for production builds; local Vite defaults to port 8000.
# Set http://127.0.0.1:8001 when using an isolated verification engine.
PUBLIC_ENGINE_URL=
